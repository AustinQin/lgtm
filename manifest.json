{
  "manifest_version": 3,
  "name": "GitCode Quick Comment",
  "version": "1.5",
  "permissions": ["storage"],
  "description": "Add quick review and issue management comments to GitCode pages",
  "host_permissions": [
    "https://gitcode.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["https://gitcode.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://gitcode.com/*"],
      "js": ["vendor/js-yaml.min.js", "issue-template.js", "issue-form.js", "content.js"],
      "css": ["styles.css", "issue-form.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GitCode Quick Comment"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
